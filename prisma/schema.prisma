generator dbml {
  provider              = "prisma-dbml-generator"
  output                = "./dbml"
  manyToMany            = "false"
  outputName            = "schema.dbml"
  includeRelationFields = "false"
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id              Int            @id @default(autoincrement())
  card_type       CardType
  name            String
  evo_type        EvolutionType?
  health_point    Int?
  pokemon_type    PokemonType?
  has_ability     Boolean?       @default(false)
  expansion_code  String
  collector_code  String
  regulation_code String
  release_date    DateTime?
  description     String?        @default("")
  created_at      DateTime       @default(now())
  updated_at      DateTime       @default(now())

  images CardImage[]

  @@map("cards")
}

model CardImage {
  id         Int      @id @default(autoincrement())
  card_id    Int
  image      String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  card       Card     @relation(fields: [card_id], references: [id])

  @@map("card_images")
}

model ExpansionCode {
  id           Int       @id @default(autoincrement())
  code         String?
  release_date DateTime?
  scrapped     Boolean   @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@map("expansion_codes")
}

enum EvolutionType {
  BASIC
  STAGE_1
  STAGE_2
  OTHER
}

enum PokemonType {
  GRASS
  FIRE
  WATER
  LIGHTING
  PSYCHIC
  DARKNESS
  METAL
  COLORLESS
  FIGHTING
  DRAGON
  OTHER
}

enum CardType {
  POKEMON
  SUPPORTER
  ITEM
  ENERGY
  POKEMON_TOOL
  STADIUM
}
