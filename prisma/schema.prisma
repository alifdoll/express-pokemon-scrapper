// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator dbml {
  provider              = "prisma-dbml-generator"
  output                = "./dbml"
  outputName            = "schema.dbml"
  includeRelationFields = false
  manyToMany            = false
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id              Int           @id @default(autoincrement())
  card_type       CardType
  name            String
  evo_type        EvolutionType
  health_point    Int
  pokemon_type    PokemonType
  has_ability     Boolean       @default(false)
  expansion_code  String
  regulation_code String
  release_date    DateTime?
  description     String?       @default("") // Jika item atau supporter, deskripsi ability dari kartu, jika pokemon kosong

  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@map("cards")
}

model CardImage {
  id      Int     @id @default(autoincrement())
  card_id Int
  image   String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@map("card_images")
}

enum EvolutionType {
  BASIC
  STAGE_1
  STAGE_2
}

enum PokemonType {
  GRASS
  FIRE
  WATER
  LIGHTING
  PSYCHIC
  DARKNESS
  METAL
  COLORLESS
}

enum CardType {
  POKEMON
  SUPPORTER
  ITEM
  ENERGY
  POKEMON_TOOL
}
