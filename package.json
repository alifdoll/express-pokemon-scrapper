{
  "name": "express-typescript",
  "version": "1.0.0",
  "description": "Express typescript.",
  "scripts": {
    "dev": "ts-node-dev --respawn ./src/app.ts",
    "build": "tsc",
    "postbuild": "tsx ./src/helpers/SymbolicLink.ts",
    "start": "node ./build/app.js",
    "watch": "tsc -p tsconfig.json --watch",
    "migrate:create": "prisma migrate dev --create-only",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "seed": "tsx ./prisma/seeders/DatabaseSeeder.ts",
    "generate": "prisma generate",
    "generate:toolbox": "prisma generate --schema=./prisma/toolbox.prisma",
    "prettier": "prettier --write ./**/*.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/client": "^5.21.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "cheerio": "^1.2.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "errsole": "^2.11.1",
    "errsole-postgres": "^2.0.0",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.2.0",
    "inngest": "^4.20.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "multer": "1.4.5-lts.1",
    "prisma": "^5.21.0",
    "slug": "^9.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/bcrypt": "^5.0.2",
    "@types/body-parser": "^1.19.5",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "@types/serve-index": "^1.9.4",
    "@types/slug": "^5.0.9",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.12.0",
    "globals": "^15.10.0",
    "husky": "^9.1.6",
    "nodemon": "^3.1.7",
    "prettier": "3.2.5",
    "prisma-dbml-generator": "^0.12.0",
    "ts-node-dev": "^2.0.0",
    "typescript-eslint": "^7.18.0"
  }
}
